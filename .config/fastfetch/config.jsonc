{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "padding": {
      "top": 1,
      "right": 3,
    },
  },
  "display": {
    "separator": "   ─   ",
    "brightColor": false,
    "key": {
      "width": 15,
    },
    "bar": {
      "char": {
        "elapsed": "█",
        "total": "░",
      },
      "width": 18,
    },
  },
  "modules": [
    "break",
    {
      "type": "title",
      "key": " 󰀄  user",
      "keyColor": "blue",
    },
    {
      "type": "os",
      "key": " 󰌽  distro",
      "keyColor": "blue",
    },
    {
      "type": "host",
      "key": " 󰌢  host",
      "keyColor": "blue",
    },
    {
      "type": "bios",
      "key": " 󰷦  bios",
      "keyColor": "blue",
    },
    {
      "type": "board",
      "key": " 󰌢  board",
      "keyColor": "blue",
    },
    {
      "type": "kernel",
      "key": " 󰠩  kernel",
      "format": "{release}",
      "keyColor": "blue",
    },
    {
      "type": "initSystem",
      "key": " 󰣇  init",
      "keyColor": "blue",
    },
    {
      "type": "uptime",
      "key": " 󰅐  uptime",
      "keyColor": "blue",
    },
    {
      "type": "packages",
      "key": " 󰏗  packages",
      "combined": true,
      "keyColor": "blue",
    },
    {
      "type": "shell",
      "key": " 󰆍  shell",
      "keyColor": "blue",
    },

    "break",
    {
      "type": "de",
      "key": " 󰖟  desktop",
      "keyColor": "green",
    },
    {
      "type": "wm",
      "key": " 󰧨  wm",
      "keyColor": "green",
    },
    {
      "type": "theme",
      "key": " 󰔎  gtk",
      "keyColor": "green",
    },
    {
      "type": "icons",
      "key": " 󰀻  icons",
      "keyColor": "green",
    },
    {
      "type": "wmTheme",
      "key": " 󰟡  wm theme",
      "keyColor": "green",
    },
    {
      "type": "wallpaper",
      "key": " 󰸉  wallpaper",
      "keyColor": "green",
    },
    {
      "type": "cursor",
      "key": " 󰇀  cursor",
      "keyColor": "green",
    },
    {
      "type": "terminal",
      "key": " 󰆍  terminal",
      "keyColor": "green",
    },
    {
      "type": "terminalfont",
      "key": " 󰛖  term font",
      "keyColor": "green",
    },
    {
      "type": "terminaltheme",
      "key": " 󰏘  palette",
      "keyColor": "green",
    },
    {
      "type": "display",
      "key": " 󰍹  display",
      "compactType": "original-with-refresh-rate",
      "keyColor": "green",
    },

    "break",
    {
      "type": "cpu",
      "key": " 󰻠  cpu",
      "format": "{name}",
      "keyColor": "yellow",
    },
    {
      "type": "cpuUsage",
      "key": " 󰻠  cpu load",
      "keyColor": "yellow",
    },
    {
      "type": "gpu",
      "key": " 󰍛  gpu",
      "keyColor": "yellow",
    },
    {
      "type": "physicalMemory",
      "key": " 󰧑  dimm",
      "keyColor": "yellow",
    },
    {
      "type": "memory",
      "key": " 󰾆  memory",
      "format": "{used} / {total} ({percentage})",
      "keyColor": "yellow",
    },
    {
      "type": "swap",
      "key": " 󰓡  swap",
      "format": "{used} / {total} ({percentage})",
      "keyColor": "yellow",
    },
    {
      "type": "disk",
      "key": " 󰋊  disk",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage})",
      "keyColor": "yellow",
    },
    {
      "type": "btrfs",
      "key": " 󰋊  btrfs",
      "keyColor": "yellow",
    },
    {
      "type": "battery",
      "key": " 󰁹  battery",
      "keyColor": "yellow",
    },
    {
      "type": "brightness",
      "key": " 󰃠  brightness",
      "keyColor": "yellow",
    },
    {
      "type": "sound",
      "key": " 󰕾  audio",
      "keyColor": "yellow",
    },
    {
      "type": "wifi",
      "key": " 󰤨  wifi",
      "keyColor": "yellow",
    },
    {
      "type": "localip",
      "key": " 󰛳  ip",
      "keyColor": "yellow",
    },
    {
      "type": "player",
      "key": " 󰥠  mpris",
      "keyColor": "yellow",
    },
    {
      "type": "media",
      "key": " 󰐊  now playing",
      "keyColor": "yellow",
    },

    "break",
    {
      "type": "physicalDisk",
      "key": " 󰋊  disks",
      "keyColor": "magenta",
    },
    {
      "type": "datetime",
      "key": " 󰃭  date",
      "format": "{year}-{month-pretty}-{day-pretty} {hour-pretty}:{minute-pretty}",
      "keyColor": "magenta",
    },
    {
      "type": "loadavg",
      "key": " 󰔟  load",
      "keyColor": "magenta",
    },
    {
      "type": "users",
      "key": " 󰍹  users",
      "keyColor": "magenta",
    }
  ],
}
