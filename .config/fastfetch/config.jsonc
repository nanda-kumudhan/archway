{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch",
    "padding": {
      "top": 1,
      "right": 3,
    },
  },
  "display": {
    "separator": "  ─  ",
    "brightColor": false,
    "key": {
      "width": 16,
    },
    "bar": {
      "char": {
        "elapsed": "█",
        "total": "░",
      },
      "width": 15,
    },
  },
  "modules": [
    "break",

    // ── System ─────────────────────────────────────────────────────────────
    {
      "type": "title",
      "key": " 󰀄  user",
      "keyColor": "cyan",
    },
    {
      "type": "os",
      "key": " 󰌽  distro",
      "keyColor": "cyan",
    },
    {
      "type": "kernel",
      "key": " 󰠩  kernel",
      "format": "{release}",
      "keyColor": "cyan",
    },
    {
      "type": "host",
      "key": " 󰌢  host",
      "keyColor": "cyan",
    },
    {
      "type": "uptime",
      "key": " 󰅐  uptime",
      "keyColor": "cyan",
    },
    {
      "type": "packages",
      "key": " 󰏗  packages",
      "combined": true,
      "keyColor": "cyan",
    },
    {
      "type": "shell",
      "key": " 󰆍  shell",
      "keyColor": "cyan",
    },
    {
      "type": "locale",
      "key": " 󰗊  locale",
      "keyColor": "cyan",
    },
    {
      "type": "command",
      "key": " 󰃰  installed",
      "keyColor": "cyan",
      "text": "python3 -c \"from datetime import date; d=open('/var/log/pacman.log').read()[1:11]; t=date.fromisoformat(d); print('{} ({} days ago)'.format(d,(date.today()-t).days))\"",
    },

    "break",

    // ── Desktop ────────────────────────────────────────────────────────────
    {
      "type": "wm",
      "key": " 󰧨  wm",
      "keyColor": "green",
    },
    {
      "type": "theme",
      "key": " 󰔎  gtk theme",
      "keyColor": "green",
    },
    {
      "type": "icons",
      "key": " 󰀻  icons",
      "keyColor": "green",
    },
    {
      "type": "cursor",
      "key": " 󰇀  cursor",
      "keyColor": "green",
    },
    {
      "type": "terminal",
      "key": " 󰆍  terminal",
      "keyColor": "green",
    },
    {
      "type": "terminalfont",
      "key": " 󰛖  font",
      "keyColor": "green",
    },
    {
      "type": "terminaltheme",
      "key": " 󰏘  palette",
      "keyColor": "green",
    },
    {
      "type": "display",
      "key": " 󰍹  display",
      "compactType": "original-with-refresh-rate",
      "keyColor": "green",
    },

    "break",

    // ── Hardware ───────────────────────────────────────────────────────────
    {
      "type": "cpu",
      "key": " 󰻠  cpu",
      "keyColor": "yellow",
    },
    {
      "type": "cpuUsage",
      "key": " 󰻠  cpu load",
      "keyColor": "yellow",
    },
    {
      "type": "gpu",
      "key": " 󰍛  gpu",
      "keyColor": "yellow",
    },
    {
      "type": "memory",
      "key": " 󰾆  memory",
      "format": "{used} / {total} ({percentage})",
      "keyColor": "yellow",
    },
    {
      "type": "swap",
      "key": " 󰓡  swap",
      "format": "{used} / {total} ({percentage})",
      "keyColor": "yellow",
    },
    {
      "type": "disk",
      "key": " 󰋊  disk",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage})",
      "keyColor": "yellow",
    },
    {
      "type": "physicalDisk",
      "key": " 󰒍  drive",
      "keyColor": "yellow",
    },
    {
      "type": "battery",
      "key": " 󰁹  battery",
      "keyColor": "yellow",
    },
    {
      "type": "brightness",
      "key": " 󰃠  brightness",
      "keyColor": "yellow",
    },
    {
      "type": "sound",
      "key": " 󰕾  audio",
      "keyColor": "yellow",
    },

    "break",

    // ── Network ────────────────────────────────────────────────────────────
    {
      "type": "wifi",
      "key": " 󰤨  wifi",
      "keyColor": "blue",
    },
    {
      "type": "bluetooth",
      "key": " 󰂯  bluetooth",
      "keyColor": "blue",
    },
    {
      "type": "localip",
      "key": " 󰛳  local ip",
      "keyColor": "blue",
    },

    "break",

    // ── Snapshot ───────────────────────────────────────────────────────────
    {
      "type": "datetime",
      "key": " 󰃭  date",
      "format": "{year}-{month-pretty}-{day-pretty}  {hour-pretty}:{minute-pretty}:{second-pretty}",
      "keyColor": "magenta",
    },

    "break",
    "colors",
  ],
}
