{
  "layer": "top",
  "position": "top",
  "exclusive": true,
  "height": 30,
  "spacing": 0,

  "modules-left": [
    "sway/workspaces",
    "sway/scratchpad"

  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "mpris",
    "wireplumber",
    "backlight",
    "battery",
    "privacy",
    "network",
    "bluetooth",
    "tray",
    "power-profiles-daemon",
    "idle_inhibitor",
  ],

  "sway/workspaces": {
    "format": "{name} {windows}",
    "format-window-separator": " ",
    "on-click": "activate",
    "sort-by-number": true,
    "all-outputs": false,

    "window-rewrite-default": "󰋙",
    // Match window app IDs/classes for desktop applications in pkglist.txt.
    // CLI programs share their terminal's app ID and use the Foot icon.
    "window-rewrite": {
      "[Aa]nki": "󰗚",
      "blueman-manager": "󰂯",
      "blueman-adapters": "󰂯",
      "brave-browser": "󰖟",
      "dbeaver": "󰆼",
      "(firefox|org.mozilla.firefox)": "󰈹",
      "foot(-client)?": "",
      "(imv|imv-dir)": "󰋩",
      "(keepassxc|org[.]keepassxc[.]KeePassXC)": "󰌆",
      "libreoffice": "󰏆",
      "libreoffice-startcenter": "󰏆",
      "libreoffice-base": "󰆼",
      "libreoffice-writer": "󰈬",
      "libreoffice-calc": "",
      "libreoffice-impress": "",
      "libreoffice-draw": "󰕳",
      "libreoffice-math": "󰙩",
      "org[.]localsend[.]localsend_app": "󰇚",
      "mpv": "󰐊",
      "nm-applet": "󰖩",
      "nm-connection-editor": "󰖩",
      "nwg-look": "󰏘",
      "(pavucontrol|org[.]pulseaudio[.]pavucontrol)": "󰕾",
      "(podman|podman-desktop|Podman Desktop|io[.]podman_desktop[.]PodmanDesktop)": "󰡨",
      "(PrismLauncher|org[.]prismlauncher[.]PrismLauncher)": "󰍳",
      "(qemu|qemu-system-.*)": "󰢹",
      "(rofi|rofi-theme-selector)": "󰍉",
      "(rpi-imager|org[.]raspberrypi[.]rpi-imager|com[.]raspberrypi[.]rpi-imager)": "",
      "org[.]remmina[.]Remmina": "󰢹",
      "system-config-printer": "󰐪",
      "([Tt]hunar|org[.]xfce[.]Thunar|thunar-settings|thunar-bulk-rename)": "󰉋",
      "thunar-volman-settings": "󱊞",
      "(torbrowser-launcher|torbrowser|Tor Browser|org[.]torproject[.]torbrowser-launcher([.]settings)?)": "󰗹",
      "virt-manager": "󰢹",
      "([Ww]aydroid.*)": "󰀲",
      "(wdisplays|network[.]cycles[.]wdisplays)": "󰍹",
      "xarchiver": "󰗄",
      "org[.]pwmt[.]zathura": "󰈙",
      "dev[.]zed[.]Zed": "",
      "polkit-gnome-authentication-agent-1": "󰌋"
    },
  },

  "sway/scratchpad": {
    "format": "{icon} {count}",
    "show-empty": false,
    "format-icons": ["", ""],
    "tooltip": true,
    "tooltip-format": "{app}: {title}"
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%a %d %b}",
    "tooltip-format": "{:%A, %d %B %Y\n%H:%M}\n\n{calendar}",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "today": "<span color='#e6e6e6'>{}</span>"
      }
    }
  },

  "mpris": {
    "format": "{status_icon}",
    "format-paused": "{status_icon}",
    "format-stopped": "",
    "dynamic-order": ["artist", "title"],
    "dynamic-importance-order": ["title", "artist"],
    "dynamic-separator": " - ",
    "dynamic-len": 42,
    "artist-len": 18,
    "title-len": 28,
    "tooltip-format": "{status_icon} {player} ({status})\nTitle: {title}\nArtist: {artist}\nAlbum: {album}\nLength: {length}",
    "status-icons": {
      "playing": "󰐊",
      "paused": "󰏤",
      "stopped": "󰓛"
    }
  },

  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁 {volume}%",
    "format-icons": [
      "󰕿",
      "󰖀",
      "󰕾"
    ],
    "max-volume": 100,
    "on-click": "pavucontrol",
    "on-click-middle": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
  },

  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": [
      "󰃞",
      "󰃟",
      "󰃠"
    ],



  },

  "battery": {
    "interval": 5,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-alt": "{icon} {time}",

    "format-charging": "󰂄 {capacity}%",
    "format-charging-alt": "󰂄 {time}",

    "format-plugged": "󰚥 {capacity}%",
    "format-plugged-alt": "󰚥 {time}",

    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂁",
      "󰁹"
    ],
    "tooltip-format": "Capacity: {capacity}%\nPower draw: {power}W\nTime remaining: {time}",
  },

  "privacy": {
    "icon-spacing": 6,
    "icon-size": 14,
    "transition-duration": 140,
    "modules": [
      {
        "type": "screenshare",
        "tooltip": true,
        "tooltip-icon-size": 18
      },
      {
        "type": "audio-in",
        "tooltip": true,
        "tooltip-icon-size": 18
      }
    ],
    "ignore-monitor": true
  },

  "network": {
    "format-wifi": "󰖩 {essid}",
    "format-ethernet": "󰈀",
    "format-linked": "󰈀",
    "format-disconnected": "󰖪",
    "format-disabled": "󰖪",
    "on-click": "nmcli radio wifi on",
    "on-click-middle": "nmcli radio wifi off",
    "tooltip-format-wifi": "Wi-Fi: {essid}\nSignal: {signalStrength}%\nIP: {ipaddr}",
    "tooltip-format-ethernet": "Ethernet\nIP: {ipaddr}",
    "tooltip-format-linked": "Connected\nInterface: {ifname}\nIP: {ipaddr}",
    "tooltip-format-disconnected": "Disconnected",
    "tooltip-format-disabled": "Network disabled",

  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-on": "󰂯",
    "format-connected": "󰂱 {device_alias}",
    "format-connected-battery": "󰂱 {device_alias} {device_battery_percentage}%",
    "on-click": "bluetoothctl power on",
    "on-click-middle": "bluetoothctl power off",
    "tooltip-format": "Bluetooth: {status}",
    "tooltip-format-connected": "Connected: {device_alias}\nBattery: {device_battery_percentage}%",

  },

  "tray": {
    "icon-size": 14,
    "spacing": 10
  },

  "power-profiles-daemon": {
      "format": "{icon}",
      "format-icons": {
          "default": "󰾆",
          "performance": "󰓅",
          "balanced": "󰾅",
          "power-saver": "󰾆"
      },
      "tooltip-format": "Power profile: {profile}"
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰛊",
      "deactivated": "󰛉"
    },
    "tooltip-format-activated": "Idle inhibitor is on",
    "tooltip-format-deactivated": "Idle inhibitor is off"
  }
}
