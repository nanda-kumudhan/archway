{
  "layer": "top",
  "position": "top",
  "exclusive": true,
  "height": 30,
  "spacing": 0,

  "modules-left": [
    "sway/workspaces",
    "sway/scratchpad"

  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "mpris",
    "wireplumber",
    "backlight",
    "battery",
    "privacy",
    "tray",
    "power-profiles-daemon",
    "idle_inhibitor",
  ],

  "sway/workspaces": {
    "format": "{name} {windows}",
    "format-window-separator": " ",
    "on-click": "activate",
    "sort-by-number": true,
    "all-outputs": false,

    "window-rewrite-default": "󰋙",
    "window-rewrite": {
      "wdisplays": "󰍹",
      "texstudio": "",
      "brave-browser": "󰖟",
      "keepassxc": "󰌆",
      "dev.zed.Zed": "",
      "firefox": "󰈹",
      "foot": "",
      "org.remmina.Remmina": "󰢹",

      "org.gnome.DiskUtility": "󰋊",
      "org.gnome.seahorse": "󰌋",
      "podman": "󰡨",
      "dbeaver": "󰆼",

      "org.localsend.localsend_app": "󰇚",

      "imv": "󰋩",
      "org.pwmt.zathura": "󰈙",
      "mpv": "󰐊",

      "Thunar": "󰉋",


      "libreoffice": "󰏆",
      "libreoffice-writer": "󰈬",
      "libreoffice-calc": "",
      "libreoffice-impress": "",
      "libreoffice-draw": "󰕳",
      "libreoffice-math": "󰙩",


      "virt-manager": "󰢹",
      "pavucontrol": "󰕾",

      "transmission-gtk": "󰇚",
      "torbrowser-launcher": "󰗹",
      "system-config-printer": "󰐪",
      "xarchiver": "󰗄",
      "Anki": "󰗚",

    }
  },

  "sway/scratchpad": {
    "format": "{icon}{count}",
    "show-empty": false,
    "format-icons": ["", ""],
    "tooltip": true,
    "tooltip-format": "{app}: {title}"
  },

  // --- Media ---
  "mpris": {
    "format": "{status_icon}",
    "format-paused": "{status_icon}",
    "format-stopped": "",
    "dynamic-order": ["artist", "title"],
    "dynamic-importance-order": ["title", "artist"],
    "dynamic-separator": " - ",
    "dynamic-len": 42,
    "artist-len": 18,
    "title-len": 28,
    "tooltip-format": "{status_icon} {player} ({status})\nTitle: {title}\nArtist: {artist}\nAlbum: {album}\nLength: {length}",
    "status-icons": {
      "playing": "󰐊",
      "paused": "󰏤",
      "stopped": "󰓛"
    }
  },

  "power-profiles-daemon": {
      "format": "{icon}",
      "format-icons": {
          "default": "󰾆",
          "performance": "󰓅",
          "balanced": "󰾅",
          "power-saver": "󰾆"
      },
      "tooltip-format": "Power profile: {profile}"
  },

  "tray": {
    "icon-size": 14,
    "spacing": 10
  },

  // --- Power & System ---
  "battery": {
    "interval": 5,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-alt": "{icon} {time}",

    "format-charging": "󰂄 {capacity}%",
    "format-charging-alt": "󰂄 {time}",

    "format-plugged": "󰚥 {capacity}%",
    "format-plugged-alt": "󰚥 {time}",

    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂁",
      "󰁹"
    ],
    "tooltip-format": "Capacity: {capacity}%\nPower draw: {power}W\nTime remaining: {time}",
  },

  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": [
      "󰃞",
      "󰃟",
      "󰃠"
    ],



  },

  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁 {volume}%",
    "format-icons": [
      "󰕿",
      "󰖀",
      "󰕾"
    ],
    "max-volume": 100,
    "on-click": "pavucontrol",
    "on-click-middle": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰛊",
      "deactivated": "󰛉"
    },
    "tooltip-format-activated": "Idle inhibitor is on",
    "tooltip-format-deactivated": "Idle inhibitor is off"
  },

  "privacy": {
    "icon-spacing": 6,
    "icon-size": 14,
    "transition-duration": 140,
    "modules": [
      {
        "type": "screenshare",
        "tooltip": true,
        "tooltip-icon-size": 18
      },
      {
        "type": "audio-in",
        "tooltip": true,
        "tooltip-icon-size": 18
      }
    ],
    "ignore-monitor": true
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%a %d %b}",
    "tooltip-format": "{:%A, %d %B %Y\n%H:%M}\n\n{calendar}",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "today": "<span color='#e6e6e6'>{}</span>"
      }
    }
  }
}
