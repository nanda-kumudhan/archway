{
  "layer": "top",
  "position": "top",
  "exclusive": true,
  "height": 30,
  "spacing": 0,

  "modules-left": [
    "sway/workspaces",
    "sway/scratchpad"

  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [

    "mpris",
    "network",
    "bluetooth",
    "wireplumber",
    "backlight",
    "battery",
    "privacy",
    "idle_inhibitor",
    "tray",
  ],

  "sway/workspaces": {
    "format": "{name} {windows}",
    "format-window-separator": " ",
    "on-click": "activate",
    "sort-by-number": true,
    "all-outputs": false,

    "window-rewrite-default": "󰋙",
    "window-rewrite": {
      "wdisplays": "󰍹",
      "texmaker": "",
      "brave-origin": "󰖟",
      "keepassxc": "󰌆",
      "dev.zed.Zed": "",
      "foot": "",
      "org.remmina.Remmina": "󰢹",

      "org.gnome.DiskUtility": "󰋊",
      "org.gnome.seahorse": "󰌋",
      "podman": "󰡨",
      "dbeaver": "󰆼",

      "class<discord>": "󰙯",
      "class<Spotify>": "󰓇",
      "class<org.prismlauncher.PrismLauncher>": "󰍹",
      "class<io.stremio.Stremio>": "󰓹",

      "org.localsend.localsend_app": "󰇚",

      "imv": "󰋩",
      "org.pwmt.zathura": "󰈙",
      "mpv": "󰐊",

      "Thunar": "󰉋",


      "libreoffice": "󰏆",
      "libreoffice-writer": "󰈬",
      "libreoffice-calc": "",
      "libreoffice-impress": "",
      "libreoffice-draw": "󰕳",
      "libreoffice-math": "󰙩",

      "blueman": "󰂯",
      "virt-manager": "󰢹",
      "pavucontrol": "󰕾",
      "nm-connection-editor": "󰛳"
    }
  },

  "sway/scratchpad": {
    "format": "{icon}{count}",
    "show-empty": false,
    "format-icons": ["", ""],
    "tooltip": true,
    "tooltip-format": "{app}: {title}"
  },

  // --- Media ---
  "mpris": {
    "format": "{status_icon}",
    "format-paused": "{status_icon}",
    "format-stopped": "",
    "dynamic-order": ["artist", "title"],
    "dynamic-importance-order": ["title", "artist"],
    "dynamic-separator": " - ",
    "dynamic-len": 42,
    "artist-len": 18,
    "title-len": 28,
    "tooltip-format": "{status_icon} {player} ({status})\nTitle: {title}\nArtist: {artist}\nAlbum: {album}\nLength: {length}",
    "status-icons": {
      "playing": "󰐊",
      "paused": "󰏤",
      "stopped": "󰓛"
    }
  },

  // --- Network ---
  "network": {
    "format-wifi": "{icon} {essid}",
    "format-ethernet": "{icon} {ipaddr}",
    "format-disconnected": "{icon} Disconnected",
    "format-icons": {
      "wifi": [
        "󰤯",
        "󰤟",
        "󰤢",
        "󰤥",
        "󰤨"
      ],
      "ethernet": [
        "󰈀"
      ]
    },
    "format-vpn": "󰖂 {vpn}",
    "tooltip-format": "Interface: {ifname}\nIP: {ipaddr}\nGateway: {gwaddr}\nSignal: {signaldBm} dBm",
    "on-click": "foot -e nmtui",
    "on-click-middle": "nmcli networking toggle"
  },

  // --- Bluetooth ---
  "bluetooth": {
    "format": "{icon} {status}",
    "format-connected": "{icon} {device_alias}",
    "format-disconnected": "{icon} Ready",
    "format-disabled": "{icon} Off",
    "format-icons": {
      "enabled": "󰂯",
      "disabled": "󰂲",
      "connected": "󰂱"
    },
    "tooltip-format": "Bluetooth: {status}\nDevice: {device_alias}",
    "on-click": "foot -e bluetoothctl",
    "on-click-middle": "bluetoothctl power off"
  },

  "tray": {
    "icon-size": 14,
    "spacing": 10
  },

  // --- Power & System ---
  "battery": {
    "interval": 5,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂁",
      "󰁹"
    ],
    "tooltip-format": "Capacity: {capacity}%\nPower draw: {power}W\nTime remaining: {time}"
  },

  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": [
      "󰃞",
      "󰃟",
      "󰃠"
    ],
    "scroll-step": 1,
    "tooltip-format": "Brightness: {percent}%"
  },

  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁 {volume}%",
    "format-icons": [
      "󰕿",
      "󰖀",
      "󰕾"
    ],
    "max-volume": 100,
    "scroll-step": 1,
    "tooltip-format": "Volume: {volume}%\nNode: {node_name}",
    "on-click": "$HOME/.config/rofi/pipewire-output",
    "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol"
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰛊",
      "deactivated": "󰛉"
    },
    "tooltip-format-activated": "Idle inhibitor is on",
    "tooltip-format-deactivated": "Idle inhibitor is off"
  },

  "privacy": {
    "icon-spacing": 6,
    "icon-size": 14,
    "transition-duration": 140,
    "modules": [
      {
        "type": "screenshare",
        "tooltip": true,
        "tooltip-icon-size": 18
      },
      {
        "type": "audio-in",
        "tooltip": true,
        "tooltip-icon-size": 18
      }
    ],
    "ignore-monitor": true
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%a %d %b}",
    "tooltip-format": "{:%A, %d %B %Y\n%H:%M}\n\n{calendar}",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "today": "<span color='#e6e6e6'>{}</span>"
      }
    }
  }
}
