{
  "layer": "top",
  "position": "top",
  "exclusive": true,
  "height": 30,
  "spacing": 0,

  "modules-left": [
    "sway/workspaces",
    "sway/scratchpad",
    "custom/cpu",
    "memory",
    "systemd-failed-units"

  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "mpris",
    "wireplumber",
    "backlight",
    "battery",
    "privacy",
    "network",
    "bluetooth",
    "tray",
    "power-profiles-daemon",
    "idle_inhibitor",
  ],

  "sway/workspaces": {
    "format": "{name}{windows}",
    "format-window-separator": "",
    "disable-click": false,
    "disable-scroll": false,
    "sort-by-number": true,
    "all-outputs": false,

    "window-rewrite-default": "",
    // Each icon includes its own leading space so unmatched windows leave no gap.
    "window-rewrite": {
      "class<[Aa]nki>": " 󰗚",
      "class<([Bb]itwarden(-desktop)?|com[.]bitwarden[.]desktop)>": " 󰒃",
      "class<([Bb]lueman-(manager|adapters)|org[.]blueman[.](Manager|Adapters)|bluetui|bluetoothctl)>": " 󰂯",
      "class<(brave(-browser)?|com[.]brave[.]Browser)>": " 󰖟",
      "class<([Dd][Bb]eaver|io[.]dbeaver[.]DBeaver)>": " 󰆼",
      "class<(easyeffects|com[.]github[.]wwmm[.]easyeffects)>": " ",
      "class<(firefox|org[.]mozilla[.]firefox)>": " 󰈹",
      "class<([Ff]irewall-config|org[.]fedoraproject[.]FirewallConfig)>": " ",
      "class<(foot(-?client)?|scratchpad_term)>": " ",
      "class<(imv|imv-dir)>": " 󰋩",
      "class<libreoffice(-startcenter)?>": " 󰏆",
      "class<libreoffice-base>": " 󰆼",
      "class<libreoffice-writer>": " 󰈬",
      "class<libreoffice-calc>": " ",
      "class<libreoffice-impress>": " ",
      "class<libreoffice-draw>": " 󰕳",
      "class<libreoffice-math>": " 󰙩",
      "class<(localsend|LocalSend|org[.]localsend[.]localsend_app)>": " 󰇚",
      "class<mpv>": " 󰐊",
      "class<(nm-applet|[Nn]m-connection-editor|nmtui)>": " 󰖩",
      "class<nwg-displays>": " 󰍹",
      "class<nwg-look>": " ",
      "class<(pavucontrol|org[.]pulseaudio[.]pavucontrol)>": " 󰕾",
      "class<(podman|podman-desktop|Podman Desktop|io[.]podman_desktop[.]PodmanDesktop)>": " 󰡨",
      "class<(PrismLauncher|org[.]prismlauncher[.]PrismLauncher)>": " 󰍳",
      "class<(qemu|qemu-system-.*)>": " 󰢹",
      "class<([Rr]emmina|org[.]remmina[.]Remmina)>": " ",
      "class<(rofi|rofi-theme-selector)>": " 󰍉",
      "class<([Rr]pi-imager|(org|com)[.]raspberrypi[.]rpi-imager|org[.]raspberrypi[.]rpi-imager[.]rpi-imager)>": " ",
      "class<([Ss]ignal(-desktop)?|org[.]signal[.]Signal)>": " 󰍩",
      "class<(stremio|Stremio|com[.]stremio[.]Stremio)>": " ",
      "class<([Ss]ystem-config-printer([.]py)?|org[.]fedoraproject[.]Config[.]Printing)>": " 󰐪",
      "class<(telegram-desktop|TelegramDesktop|org[.]telegram[.]desktop)>": " ",
      "class<([Tt]e[Xx]studio|org[.]texstudio[.]TeXstudio)>": " ",
      "class<([Tt]hunar|org[.]xfce[.]Thunar|thunar-settings|thunar-bulk-rename)>": " 󰉋",
      "class<thunar-volman-settings>": " 󱊞",
      "class<(torbrowser-launcher|torbrowser|Tor Browser|org[.]torproject[.]torbrowser-launcher([.]settings)?)>": " 󰗹",
      "class<(veracrypt|VeraCrypt)>": " ",
      "class<[Vv]irt-manager>": " 󰢹",
      "class<[Ww]aydroid.*>": " 󰀲",
      "class<([Xx]archiver|org[.]xfce[.]Xarchiver)>": " 󰗄",
      "class<([Zz]athura|org[.]pwmt[.]zathura)>": " 󰈙",
      "class<dev[.]zed[.]Zed>": " ",
      "class<polkit-gnome-authentication-agent-1>": " 󰌋"
    },
  },

  "sway/scratchpad": {
    "format": "{icon} {count}",
    "show-empty": false,
    "format-icons": ["", ""],
    "tooltip": true,
    "tooltip-format": "{app}: {title}"
  },

  "clock": {
    "interval": 60,
    "format": "{:%H:%M}",
    "tooltip-format": "{calendar}",
    "calendar": {
      "mode": "month",
      "format": {
        "today": "<u>{}</u>"
      }
    }
  },

  "custom/cpu": {
    // The reader samples every 60 seconds, including tooltip-only details.
    "exec": "python3 $HOME/.config/waybar/scripts/cpu.py",
    "return-type": "json",
    "format": " {text}",
    "restart-interval": 60
  },

  "memory": {
    "interval": 60,
    "format": "󰍛 {percentage}%",
    "format-alt": "󰍛 {used:.1f} GiB",
    "format-alt-click": 1,
    "tooltip-format": "Memory: {used:.1f} / {total:.1f} GiB ({percentage}%)\nLeft-click: toggle percentage / GiB"
  },

  "systemd-failed-units": {
    "interval": 60,
    "hide-on-ok": true,
    "format": " {nr_failed}",
    "system": true,
    "user": true
  },

  "mpris": {
    // Native controls: left-click play/pause, middle-click previous, right-click next.
    "format": "{status_icon}",
    "format-paused": "{status_icon}",
    "format-stopped": "",
    "dynamic-order": ["artist", "title"],
    "dynamic-importance-order": ["title", "artist"],
    "dynamic-separator": " - ",
    "dynamic-len": 42,
    "artist-len": 18,
    "title-len": 28,
    "tooltip-format": "{status_icon} {player} ({status})\nTitle: {title}\nArtist: {artist}\nAlbum: {album}\nLength: {length}\n\nLeft-click: play/pause\nMiddle-click: previous track\nRight-click: next track",
    "status-icons": {
      "playing": "󰐊",
      "paused": "󰏤",
      "stopped": "󰓛"
    }
  },

  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁 {volume}%",
    "format-icons": [
      "󰕿",
      "󰖀",
      "󰕾"
    ],
    "max-volume": 100,
    "on-click": "pavucontrol",
    "on-click-middle": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
  },

  "backlight": {
    // Keep periodic hardware checks infrequent to reduce wakeups.
    "interval": 60,
    "format": "{icon} {percent}%",
    "format-icons": [
      "󰃞",
      "󰃟",
      "󰃠"
    ],



  },

  "battery": {
    // Battery percentage and power estimates do not need rapid polling.
    "interval": 60,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-alt": "{icon} {time}",

    "format-charging": "󰂄 {capacity}%",
    "format-charging-alt": "󰂄 {time}",

    "format-plugged": "󰚥 {capacity}%",
    "format-plugged-alt": "󰚥 {time}",

    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂁",
      "󰁹"
    ],
    "tooltip-format": "Capacity: {capacity}%\nPower draw: {power}W\nTime remaining: {time}",
  },

  "privacy": {
    "icon-spacing": 6,
    "icon-size": 14,
    "transition-duration": 0,
    "modules": [
      {
        "type": "screenshare",
        "tooltip": true,
        "tooltip-icon-size": 18
      },
      {
        "type": "audio-in",
        "tooltip": true,
        "tooltip-icon-size": 18
      }
    ],
    "ignore-monitor": true
  },

  "network": {
    // Connection changes still arrive through network events.
    "interval": 120,
    "format-wifi": "󰖩 {essid}",
    "format-ethernet": "󰈀",
    "format-linked": "󰈀",
    "format-disconnected": "󰖪",
    "format-disabled": "󰖪",
    "on-click": "nmcli radio wifi on",
    "on-click-middle": "nmcli radio wifi off",
    "tooltip-format-wifi": "Wi-Fi: {essid}\nSignal: {signalStrength}%\nIP: {ipaddr}",
    "tooltip-format-ethernet": "Ethernet\nIP: {ipaddr}",
    "tooltip-format-linked": "Connected\nInterface: {ifname}\nIP: {ipaddr}",
    "tooltip-format-disconnected": "Disconnected",
    "tooltip-format-disabled": "Network disabled",

  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-on": "󰂯",
    "format-connected": "󰂱 {device_alias}",
    "format-connected-battery": "󰂱 {device_alias} {device_battery_percentage}%",
    "on-click": "bluetoothctl power on",
    "on-click-middle": "bluetoothctl power off",
    "tooltip-format": "Bluetooth: {status}",
    "tooltip-format-connected": "Connected: {device_alias}\nBattery: {device_battery_percentage}%",

  },

  "tray": {
    "icon-size": 14,
    "spacing": 10
  },

  "power-profiles-daemon": {
      "format": "{icon}",
      "format-icons": {
          "default": "󰾆",
          "performance": "󰓅",
          "balanced": "󰾅",
          "power-saver": "󰾆"
      },
      "tooltip-format": "Power profile: {profile}"
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰛊",
      "deactivated": "󰛉"
    },
    "tooltip-format-activated": "Idle inhibitor is on",
    "tooltip-format-deactivated": "Idle inhibitor is off"
  }
}
