* {
    surface:         #191919;
    field:           #272727;
    selection:       #424242;
    outline:         #353535;
    foreground:      #f1f1f1;
    muted:           #b6b6b6;
    urgent:          #ffada6;

    background-color: transparent;
    text-color:       @foreground;
    font:             "Sans 13";
}

window {
    location:         north;
    anchor:           north;
    y-offset:         16%;
    width:            calc(90% min 620px);
    border:           1px;
    border-color:     @outline;
    border-radius:    16px;
    background-color: @surface;
    padding:          14px;
}

mainbox {
    spacing: 12px;
    children: [ inputbar, message, listview ];
}

inputbar {
    children:         [ textbox-search, entry, prompt ];
    spacing:          12px;
    padding:          10px 14px;
    background-color: @field;
    border-radius:    10px;
}

textbox-search {
    content:        "󰍉";
    font:           "JetBrainsMono Nerd Font Mono 17";
    expand:         false;
    width:          25px;
    text-color:     @muted;
    vertical-align: 0.5;
}

entry {
    font:              "Sans 16";
    placeholder:       "Type to search";
    placeholder-color: @muted;
    vertical-align:    0.5;
}

prompt {
    font:           "Sans Medium 11";
    expand:         false;
    text-color:     @muted;
    vertical-align: 0.5;
}

listview {
    lines:        8;
    columns:      1;
    spacing:      3px;
    fixed-height: false;
    scrollbar:    false;
}

element {
    padding:       7px 10px;
    spacing:       10px;
    border-radius: 8px;
}

element-text {
    text-color:     inherit;
    vertical-align: 0.5;
}

element-icon {
    size: 26px;
}

element normal.urgent,
element alternate.urgent,
element selected.urgent {
    text-color: @urgent;
}

element selected {
    background-color: @selection;
}

message {
    padding:          8px 10px;
    border-radius:    8px;
    background-color: @field;
}
