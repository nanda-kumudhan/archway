* {
    bg:              #121212;
    bg-alt:          #1d1d1d;
    bg-selected:     #272727;
    bg-hover:        #2a2a2a;

    fg:              #e8eaed;
    fg-muted:        #9aa0a6;
    fg-subtle:       #6f7378;

    border:          #2a2a2a;
    border-strong:   #8ab4f8;
    accent:          #8ab4f8;
    urgent:          #f28b82;

    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 11";
}

window {
    width:            34%;
    border:           1px;
    border-color:     @border;
    background-color: @bg;
    padding:          7px;
}

mainbox {
    spacing: 8px;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 8px;
    padding: 6px 10px;
    background-color: @bg-alt;
    border: 1px;
    border-color: @border;
}

prompt {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 11";
}

entry {
    placeholder: "Search";
    placeholder-color: @fg-subtle;
    text-color: @fg;
}

listview {
    lines: 12;
    columns: 1;     /* IMPORTANT: keeps it stable list-based */
    spacing: 2px;
    fixed-height: true;
    scrollbar: false;
}

element {
    padding: 6px 9px;
    border: 1px;
    border-color: transparent;
}

element-text {
    text-color: inherit;
}

element-icon {
    size: 1.1em;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg-muted;
}

element selected.normal,
element selected.active {
    background-color: @bg-selected;
    border-color: @border-strong;
    text-color: @fg;
}

element normal.urgent,
element alternate.urgent,
element selected.urgent {
    background-color: @bg-selected;
    border-color: @urgent;
    text-color: @fg;
}

message {
    border: 1px;
    border-color: @border;
    background-color: @bg-alt;
    padding: 8px 10px;
}

textbox {
    text-color: @fg;
}
