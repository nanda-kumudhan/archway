[global]
    monitor = 0
    follow = mouse

    width = 340
    origin = top-right
    offset = 10x10

    notification_limit = 5

    frame_width = 1
    frame_color = "#2a2a2a"

    gap_size = 4
    padding = 8

    horizontal_padding = 8
    vertical_padding = 6

    font = Sans 11

    icon_position = left
    min_icon_size = 32
    max_icon_size = 64

    markup = full
    plain_text = no

    format = "<b>%s</b>\n%b"

    alignment = left
    vertical_alignment = center

    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle

    ignore_newline = no

    stack_duplicates = true
    hide_duplicate_count = false

    idle_threshold = 120

    separator_height = 2
    separator_color = frame

    background = "#121212"
    foreground = "#e8eaed"

    timeout = 5

    mouse_left_click = close_current
    mouse_middle_click = do_action
    mouse_right_click = close_all

[urgency_low]
    background = "#121212"
    foreground = "#9aa0a6"
    frame_color = "#2a2a2a"
    timeout = 4

[urgency_normal]
    background = "#121212"
    foreground = "#e8eaed"
    frame_color = "#8ab4f8"
    timeout = 6

[urgency_critical]
    background = "#121212"
    foreground = "#ffffff"
    frame_color = "#f28b82"
    timeout = 0
